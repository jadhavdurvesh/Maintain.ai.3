{
  "name": "maintain-ai-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "MAINTAIN AI local intelligence desktop application",
  "author": {
    "name": "MAINTAIN AI",
    "email": "jadhavdurvesh@users.noreply.github.com"
  },
  "homepage": "https://github.com/jadhavdurvesh/Maintain.ai.3",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "com.dmjgroup.maintainai",
    "productName": "MAINTAIN AI",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "MAINTAIN AI <jadhavdurvesh@users.noreply.github.com>"
    }
  }
}
